# Активный стенд: local | ci
STAGE=local

# Хосты стенда (переопределяют дефолты из config/stages.py)
API_HOST_LOCAL=http://localhost:8000
UI_HOST_LOCAL=http://localhost:3000

# Сбросить стенд перед прогоном (POST /api/reset). В параллельном прогоне
# выполняется только мастер-процессом, до старта worker'ов.
RESET_BEFORE_RUN=false

# --- Seed-пользователи песочницы -------------------------------------------
# Хэндлы (используются в путях /users/{username}/...)
USERNAME_ADMIN=admin
USERNAME_MODERATOR=moderator
USERNAME_ACTIVE=alice_dev
USERNAME_MEDIA=bob_photo
USERNAME_LONGREAD=carol_writes
USERNAME_PRIVATE=dave_quiet
USERNAME_EMPTY=eve_new
USERNAME_BANNED=frank_banned

# Учётные данные (см. README песочницы)
EMAIL_ADMIN=
PASSWORD_ADMIN=
EMAIL_MODERATOR=
PASSWORD_MODERATOR=
EMAIL_ACTIVE=
PASSWORD_ACTIVE=
EMAIL_MEDIA=
PASSWORD_MEDIA=
EMAIL_LONGREAD=
PASSWORD_LONGREAD=
EMAIL_PRIVATE=
PASSWORD_PRIVATE=
EMAIL_EMPTY=
PASSWORD_EMPTY=
EMAIL_BANNED=
PASSWORD_BANNED=

# --- БД стенда --------------------------------------------------------------
# Нужна там, где состояние через API не воспроизвести (окно редактирования,
# soft delete, сверка счётчиков).
DB_HOST_LOCAL=localhost
DB_PORT_LOCAL=5432
DB_NAME_LOCAL=
DB_USER_LOCAL=
DB_PASSWORD_LOCAL=

# --- Fixture-сущности (опционально) -----------------------------------------
FIXTURE_POST_ID_LOCAL=
FIXTURE_CONVERSATION_ID_LOCAL=
